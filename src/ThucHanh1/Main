import java.util.Scanner;

public class Main {
    static int n = 4;
    static int k = 2;
    static int[] comb = new int[k];

    static void generate(int start, int position) {
        if (position == k) {
            System.out.println(comb[0] + " " + comb[1]);
            return;
        }

        for (int x = start; x <= n; x++) {
            comb[position] = x;
            generate(x + 1, position + 1);
        }
    }
}